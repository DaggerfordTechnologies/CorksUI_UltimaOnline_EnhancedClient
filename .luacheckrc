-- Variables the default UI code leaks into the global table (a missing "local"),
-- copied into Interface.lua, ActionsWindow.lua and MapWindow.lua with it. Listed
-- so luacheck stays quiet about them; don't add to this for new code.
globals_leaked = {
	"dialog", "err", "lastShardSelected", "ok", "playerId", "propWindowX", "propWindowY",
	"timePassed", "timer", "waypointFacet", "waypointX", "waypointY", "whisperTarget",
}

for _, list in ipairs({ globals_default_ui, globals_leaked }) do
	for _, name in ipairs(list) do
		table.insert(globals, name)
	end
end
