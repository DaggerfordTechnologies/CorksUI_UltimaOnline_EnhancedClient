<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>

    <!-- Gear Watcher Setup: the repair popup settings. Opened from the Setup
         button on the Gear Watcher. Size must match CorksGearWatcherSetup.WIDTH / HEIGHT -->
    <Window name="CorksGearWatcherSetup" movable="true" layer="popup">
      <Size>
        <AbsPoint x="320" y="190" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center">
          <AbsPoint x="0" y="0" />
        </Anchor>
      </Anchors>
      <EventHandlers>
        <EventHandler event="OnInitialize" function="CorksGearWatcherSetup.Initialize" />
        <EventHandler event="OnShutdown" function="CorksGearWatcherSetup.Shutdown" />
        <EventHandler event="OnUpdate" function="CorksGearWatcherSetup.OnUpdate" />
        <EventHandler event="OnRButtonUp" function="CorksGearWatcherSetup.OnClose" />
        <EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
      </EventHandlers>
      <Windows>
        <Window name="$parentChrome" inherits="UO_DefaultWindow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>
        <!-- Holder for the classic gump art background (CorksGearWatcherSetup.ClassicBackground) -->
        <Window name="$parentClassicBG" handleinput="false" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>

        <!-- Turn the repair popup on or off -->
        <Button name="$parentPopupButton" inherits="UO_Default_Check_Button">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="44" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnPopupButton" />
          </EventHandlers>
        </Button>
        <Label name="$parentPopupLabel" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false">
          <Size>
            <AbsPoint x="250" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentPopupButton">
              <AbsPoint x="8" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="200" b="50" a="255" />
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnPopupLabel" />
          </EventHandlers>
        </Label>

        <!-- Alert level: - 25% + -->
        <Label name="$parentLevelHeader" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false">
          <Size>
            <AbsPoint x="280" y="20" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="80" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <Button name="$parentMinusButton" inherits="UO_Default_Minus_Button">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="100" y="106" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnMinus" />
          </EventHandlers>
        </Button>
        <Label name="$parentLevel" font="UO_DefaultText" maxchars="8" textalign="center" handleinput="false">
          <Size>
            <AbsPoint x="74" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentMinusButton">
              <AbsPoint x="0" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <Button name="$parentPlusButton" inherits="UO_Default_Plus_Button">
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentLevel">
              <AbsPoint x="0" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnPlus" />
          </EventHandlers>
        </Button>

        <!-- When the popup shows -->
        <Label name="$parentNote" font="UO_DefaultText" maxchars="128" textalign="left" handleinput="false" wordwrap="true">
          <Size>
            <AbsPoint x="280" y="40" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="138" />
            </Anchor>
          </Anchors>
          <Color r="180" g="180" b="180" a="255" />
        </Label>
      </Windows>
    </Window>

  </Windows>
</Interface>
