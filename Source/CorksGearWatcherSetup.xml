<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>

    <!-- Check box with its text; clicking the text toggles it too -->
    <Window name="CorksGearSetupCheckRow">
      <Size>
        <AbsPoint x="300" y="24" />
      </Size>
      <Windows>
        <Button name="$parentButton" inherits="UO_Default_Check_Button">
          <Anchors>
            <Anchor point="left" relativePoint="left" />
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnCheckButton" />
          </EventHandlers>
        </Button>
        <Label name="$parentLabel" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false">
          <Size>
            <AbsPoint x="265" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentButton">
              <AbsPoint x="8" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnCheckLabel" />
          </EventHandlers>
        </Label>
      </Windows>
    </Window>

    <!-- One of the "Show durability as" choices; works like a radio button -->
    <Window name="CorksGearSetupFormatRow">
      <Size>
        <AbsPoint x="100" y="24" />
      </Size>
      <Windows>
        <Button name="$parentButton" inherits="UO_Default_Check_Button">
          <Anchors>
            <Anchor point="left" relativePoint="left" />
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnFormatClick" />
          </EventHandlers>
        </Button>
        <Label name="$parentLabel" font="UO_DefaultText" maxchars="16" textalign="left" wordwrap="false">
          <Size>
            <AbsPoint x="68" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentButton">
              <AbsPoint x="6" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksGearWatcherSetup.OnFormatClick" />
          </EventHandlers>
        </Label>
      </Windows>
    </Window>

    <!-- Name, slider and value ("25%") on one line -->
    <Window name="CorksGearSetupSliderRow">
      <Size>
        <AbsPoint x="300" y="24" />
      </Size>
      <Windows>
        <Label name="$parentName" font="UO_DefaultText" maxchars="32" textalign="left" wordwrap="false" handleinput="false">
          <Size>
            <AbsPoint x="128" y="20" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left" />
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <!-- numticks: one step per whole percent over 1..99 (the template has 50).
             Lua rounds the position to a whole percent either way. -->
        <SliderBar name="$parentSlider" inherits="UO_Default_Horizontal_SliderBar" numticks="98">
          <Size>
            <AbsPoint x="112" y="16" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="132" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnSlide" function="CorksGearWatcherSetup.OnSlide" />
          </EventHandlers>
        </SliderBar>
        <Label name="$parentValue" font="UO_DefaultText" maxchars="8" textalign="right" wordwrap="false" handleinput="false">
          <Size>
            <AbsPoint x="50" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="right" />
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
      </Windows>
    </Window>

    <!-- Section heading -->
    <Label name="CorksGearSetupHeading" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false" handleinput="false">
      <Size>
        <AbsPoint x="300" y="20" />
      </Size>
      <Color r="255" g="200" b="50" a="255" />
    </Label>

    <!-- Gear Watcher Setup. Opened from the Setup button on the Gear Watcher.
         Size must match CorksGearWatcherSetup.WIDTH / HEIGHT -->
    <Window name="CorksGearWatcherSetup" movable="true" layer="popup">
      <Size>
        <AbsPoint x="340" y="470" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center">
          <AbsPoint x="0" y="0" />
        </Anchor>
      </Anchors>
      <EventHandlers>
        <EventHandler event="OnInitialize" function="CorksGearWatcherSetup.Initialize" />
        <EventHandler event="OnShutdown" function="CorksGearWatcherSetup.Shutdown" />
        <EventHandler event="OnUpdate" function="CorksGearWatcherSetup.OnUpdate" />
        <EventHandler event="OnRButtonUp" function="CorksGearWatcherSetup.OnClose" />
        <EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
      </EventHandlers>
      <Windows>
        <Window name="$parentChrome" inherits="UO_DefaultWindow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>
        <!-- Holder for the classic gump art background (CorksGearWatcherSetup.ClassicBackground) -->
        <Window name="$parentClassicBG" handleinput="false" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>

        <!-- Repair alert -->
        <Label name="$parentAlertHeading" inherits="CorksGearSetupHeading">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="40" />
            </Anchor>
          </Anchors>
        </Label>
        <Window name="$parentPopup" inherits="CorksGearSetupCheckRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="64" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentChat" inherits="CorksGearSetupCheckRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="90" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentAlert" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="118" />
            </Anchor>
          </Anchors>
        </Window>

        <!-- Gear Watcher list -->
        <Label name="$parentListHeading" inherits="CorksGearSetupHeading">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="156" />
            </Anchor>
          </Anchors>
        </Label>
        <Window name="$parentHide" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="180" />
            </Anchor>
          </Anchors>
        </Window>
        <Label name="$parentFormatHeading" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false" handleinput="false">
          <Size>
            <AbsPoint x="300" y="20" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="210" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <Window name="$parentFormatPoints" inherits="CorksGearSetupFormatRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="234" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentFormatPercent" inherits="CorksGearSetupFormatRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="120" y="234" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentFormatBoth" inherits="CorksGearSetupFormatRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="220" y="234" />
            </Anchor>
          </Anchors>
        </Window>

        <!-- Colour levels -->
        <Label name="$parentColorHeading" inherits="CorksGearSetupHeading">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="272" />
            </Anchor>
          </Anchors>
        </Label>
        <Window name="$parentGreen" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="296" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentYellow" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="322" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentOrange" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="348" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentDarkOrange" inherits="CorksGearSetupSliderRow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="374" />
            </Anchor>
          </Anchors>
        </Window>

        <!-- Notes -->
        <Label name="$parentNote" font="UO_DefaultText" maxchars="256" textalign="left" handleinput="false" wordwrap="true">
          <Size>
            <AbsPoint x="300" y="60" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="20" y="404" />
            </Anchor>
          </Anchors>
          <Color r="180" g="180" b="180" a="255" />
        </Label>
      </Windows>
    </Window>

  </Windows>
</Interface>
