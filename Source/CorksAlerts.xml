<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>

    <!-- One row per alert (check box plus its name), or a group title -->
    <Window name="CorksAlertsRowTemplate">
      <Size>
        <AbsPoint x="300" y="24" />
      </Size>
      <Windows>
        <Button name="$parentButton" inherits="UO_Default_Check_Button">
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="5" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksAlerts.OnRowButton" />
          </EventHandlers>
        </Button>
        <Label name="$parentLabel" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false">
          <Size>
            <AbsPoint x="265" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="left" relativeTo="$parentButton">
              <AbsPoint x="8" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksAlerts.OnRowLabel" />
          </EventHandlers>
        </Label>
      </Windows>
    </Window>

    <Window name="CorksAlerts" movable="true" layer="popup">
      <Size>
        <AbsPoint x="350" y="560" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center">
          <AbsPoint x="0" y="0" />
        </Anchor>
      </Anchors>
      <EventHandlers>
        <EventHandler event="OnInitialize" function="CorksAlerts.Initialize" />
        <EventHandler event="OnShutdown" function="CorksAlerts.Shutdown" />
        <EventHandler event="OnUpdate" function="CorksAlerts.OnUpdate" />
        <EventHandler event="OnRButtonUp" function="CorksAlerts.OnClose" />
        <EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
      </EventHandlers>
      <Windows>
        <Window name="$parentChrome" inherits="UO_DefaultWindow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>

        <Label name="$parentHint" font="UO_DefaultText" maxchars="128" textalign="left" handleinput="false" wordwrap="true">
          <Size>
            <AbsPoint x="310" y="20" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="38" />
            </Anchor>
          </Anchors>
        </Label>

