<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
	<Windows>
		<!-- Checkbox row template. The font is set here in the XML (like the Target Text
		     label) rather than from Lua, so it shows at the same size as the other text. -->
		<Window name="CorksTargetingCheckRow">
			<Size>
				<AbsPoint x="180" y="24" />
			</Size>
			<Windows>
				<Button name="$parentButton" inherits="UO_Default_Check_Button">
					<Anchors>
						<Anchor point="left" relativePoint="left">
							<AbsPoint x="5" y="0" />
						</Anchor>
					</Anchors>
				</Button>
				<Label name="$parentLabel" font="UO_DefaultText" maxchars="64" textalign="left" wordwrap="false">
					<Size>
						<AbsPoint x="160" y="22" />
					</Size>
					<Anchors>
						<Anchor point="right" relativePoint="left" relativeTo="$parentButton">
							<AbsPoint x="5" y="0" />
						</Anchor>
					</Anchors>
					<Color r="255" g="255" b="255" a="255" />
					<EventHandlers>
						<EventHandler event="OnLButtonDown" function="CorksTargeting.OnCheckLabelClick" />
					</EventHandlers>
				</Label>
			</Windows>
		</Window>
		<Window name="CorksTargetingWindow" movable="true" layer="popup">
			<Size>
				<AbsPoint x="230" y="404" />
			</Size>
			<Anchors>
				<Anchor point="center" relativePoint="center">
					<AbsPoint x="0" y="0" />
				</Anchor>
			</Anchors>
			<EventHandlers>
				<EventHandler event="OnInitialize" function="CorksTargeting.Initialize" />
				<EventHandler event="OnShutdown" function="CorksTargeting.Shutdown" />
				<EventHandler event="OnRButtonUp" function="CorksTargeting.OnClose" />
				<EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
			</EventHandlers>
			<Windows>
				<Window name="$parentChrome" inherits="UO_DefaultWindow">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" />
						<Anchor point="bottomright" relativePoint="bottomright" />
					</Anchors>
				</Window>
				<!-- Holder for the classic gump art background (CorksTargeting.ClassicBackground) -->
				<Window name="$parentClassicBG" handleinput="false" layer="background">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" />
						<Anchor point="bottomright" relativePoint="bottomright" />
					</Anchors>
				</Window>
				<Window name="CorksTargetingWindowContent">
					<Size>
						<AbsPoint x="200" y="354" />
					</Size>
					<Anchors>
						<Anchor point="top" relativePoint="top">
							<AbsPoint x="0" y="36" />
						</Anchor>
					</Anchors>
					<Windows>
						<FullResizeImage name="$parentBackground" inherits="UO_Simple_Black_Background">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft">
									<AbsPoint x="-5" y="-5" />
								</Anchor>
								<Anchor point="bottomright" relativePoint="bottomright">
									<AbsPoint x="5" y="5" />
								</Anchor>
							</Anchors>
						</FullResizeImage>
						<FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft">
									<AbsPoint x="-5" y="-5" />
								</Anchor>
								<Anchor point="bottomright" relativePoint="bottomright">
									<AbsPoint x="5" y="5" />
								</Anchor>
							</Anchors>
						</FullResizeImage>
						<Window name="CorksTargetingWindowScrollChild">
							<Size>
								<AbsPoint x="180" y="324" />
							</Size>
							<Windows>
							</Windows>
						</Window>
					</Windows>
				</Window>
				<!-- Name filter: a direct child of the root window (like the Chat Filter box) so
				     the edit box gets clicks and keyboard focus. Anchored from Lua under the checkboxes. -->
				<Label name="CorksNameFilterLabel" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false" layer="overlay">
					<Size>
						<AbsPoint x="180" y="22" />
					</Size>
				</Label>
				<!-- Border behind the edit box. Declared before it and on the overlay layer, so it is
				     drawn above the panel background but under the typed text. Anchored from Lua. -->
				<Window name="CorksNameFilterBoxBG" handleinput="false" layer="overlay">
					<Size>
						<AbsPoint x="170" y="34" />
					</Size>
					<Windows>
						<FullResizeImage name="$parentBG" inherits="UO_Simple_Black_Background">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" />
								<Anchor point="bottomright" relativePoint="bottomright" />
							</Anchors>
						</FullResizeImage>
						<FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" />
								<Anchor point="bottomright" relativePoint="bottomright" />
							</Anchors>
						</FullResizeImage>
					</Windows>
				</Window>
				<EditBox name="CorksNameFilterBox" font="UO_DefaultText" taborder="1" maxchars="100" scrolling="horz" layer="overlay">
					<Size>
						<AbsPoint x="160" y="24" />
					</Size>
					<EventHandlers>
						<EventHandler event="OnLButtonUp" function="CorksTargeting.OnNameFilterClick" />
						<EventHandler event="OnKeyEnter" function="CorksTargeting.OnNameFilterEnter" />
						<EventHandler event="OnKeyEscape" function="CorksTargeting.OnNameFilterEnter" />
					</EventHandlers>
				</EditBox>
				<!-- Max distance: anchored from Lua under the name filter box. -->
				<Label name="CorksMaxDistanceLabel" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false" layer="overlay">
					<Size>
						<AbsPoint x="180" y="22" />
					</Size>
				</Label>
				<SliderBar name="CorksMaxDistanceSlider" inherits="UO_Default_Horizontal_SliderBar" layer="overlay">
					<Size>
						<AbsPoint x="160" y="16" />
					</Size>
					<EventHandlers>
						<EventHandler event="OnSlide" function="CorksTargeting.OnMaxDistanceSlide" />
					</EventHandlers>
				</SliderBar>
			</Windows>
		</Window>
	</Windows>
</Interface>
