        <EventHandler event="OnInitialize" function="CorksCombatMeter.Initialize" />
        <EventHandler event="OnShutdown" function="CorksCombatMeter.Shutdown" />
        <EventHandler event="OnUpdate" function="CorksCombatMeter.OnWindowUpdate" />
        <EventHandler event="OnRButtonUp" function="CorksCombatMeter.OnClose" />
        <EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
