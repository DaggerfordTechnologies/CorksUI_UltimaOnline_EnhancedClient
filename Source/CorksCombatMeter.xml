<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>

    <!-- Corks' Combat Meter. Made by a script; the Meter and Setup panels share the
         window and the Setup button swaps them. Every row is defined here (not
         created at runtime) so the rows keep the window's scale. Controls inside the
         panels have full names (CorksCombatMeter...), which the Lua uses. Size must
         match CorksCombatMeter.WIDTH / HEIGHT; row counts match STAT_ROWS,
         ENEMY_ROWS, RECENT_ROWS and FIGHT_ROWS. -->
    <Window name="CorksCombatMeter" movable="true" layer="popup">
      <Size>
        <AbsPoint x="380" y="446" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center">
          <AbsPoint x="0" y="0" />
        </Anchor>
