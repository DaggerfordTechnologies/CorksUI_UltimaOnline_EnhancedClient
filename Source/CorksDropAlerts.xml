<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>

    <!-- One row per drop message: stripe, check box, message, count on the right.
         $parentCheck holds the classic check box art (CorksDropAlerts.ClassicCheck); when
         it's in use the EC $parentButton is hidden but still keeps the checked state. -->
    <Window name="CorksDropAlertsRowTemplate">
      <Size>
        <AbsPoint x="384" y="24" />
      </Size>
      <Windows>
        <FullResizeImage name="$parentStripe" inherits="UO_Simple_Black_Background" handleinput="false" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </FullResizeImage>
        <Button name="$parentButton" inherits="UO_Default_Check_Button">
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="5" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnRowButton" />
          </EventHandlers>
        </Button>
        <Window name="$parentCheck">
          <Size>
            <AbsPoint x="22" y="22" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="5" y="0" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnRowCheck" />
          </EventHandlers>
        </Window>
        <Label name="$parentLabel" font="UO_DefaultText" maxchars="256" textalign="left" wordwrap="false">
          <Size>
            <AbsPoint x="296" y="20" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="34" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnRowLabel" />
          </EventHandlers>
        </Label>
        <Label name="$parentCount" font="UO_DefaultText" maxchars="16" textalign="right" wordwrap="false" handleinput="false">
          <Size>
            <AbsPoint x="46" y="20" />
          </Size>
          <Anchors>
            <Anchor point="right" relativePoint="right">
              <AbsPoint x="-8" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="200" b="50" a="255" />
        </Label>
      </Windows>
    </Window>

    <!-- Classic art button: art drawn into $parentArt from Lua, text beside it -->
    <Window name="CorksDropAlertsClassicButton">
      <Size>
        <AbsPoint x="170" y="26" />
      </Size>
      <EventHandlers>
        <EventHandler event="OnLButtonDown" function="CorksDropAlerts.OnClassicButtonDown" />
        <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnClassicButtonUp" />
        <EventHandler event="OnMouseOver" function="CorksDropAlerts.OnClassicButtonOver" />
        <EventHandler event="OnMouseOverEnd" function="CorksDropAlerts.OnClassicButtonOverEnd" />
      </EventHandlers>
      <Windows>
        <Window name="$parentArt" handleinput="false">
          <Size>
            <AbsPoint x="32" y="26" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left" />
          </Anchors>
        </Window>
        <Label name="$parentText" font="UO_DefaultText" maxchars="32" textalign="left" wordwrap="false" handleinput="false">
          <Size>
            <AbsPoint x="134" y="20" />
          </Size>
          <Anchors>
            <Anchor point="left" relativePoint="left">
              <AbsPoint x="36" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
      </Windows>
    </Window>

    <!-- Rows are defined up front (not created at runtime) so they keep their scale.
         Keep in sync with CorksDropAlerts.MAX_ROWS. The height is set from Lua to fit
         the rows in use (CorksDropAlerts.HeightFor). -->
    <Window name="CorksDropAlertsWindow" movable="true" layer="popup">
      <Size>
        <AbsPoint x="420" y="602" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center">
          <AbsPoint x="0" y="0" />
        </Anchor>
      </Anchors>
      <EventHandlers>
        <EventHandler event="OnInitialize" function="CorksDropAlerts.Initialize" />
        <EventHandler event="OnShutdown" function="CorksDropAlerts.Shutdown" />
        <EventHandler event="OnUpdate" function="CorksDropAlerts.OnUpdate" />
        <EventHandler event="OnRButtonUp" function="CorksDropAlerts.OnClose" />
        <EventHandler event="OnMouseWheel" function="WindowUtils.Scale" />
      </EventHandlers>
      <Windows>
        <Window name="$parentChrome" inherits="UO_DefaultWindow">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>
        <!-- Holder for the classic gump art background (CorksDropAlerts.ClassicBackground) -->
        <Window name="$parentClassicBG" handleinput="false" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" />
            <Anchor point="bottomright" relativePoint="bottomright" />
          </Anchors>
        </Window>

        <!-- Header: artifact banner on the left, session total on the right -->
        <!-- Texture set from Lua (CorksDropAlerts.InitBanner), as CenterScreenText does -->
        <DynamicImage name="$parentBanner" handleinput="false">
          <Size>
            <AbsPoint x="154" y="56" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="38" />
            </Anchor>
          </Anchors>
        </DynamicImage>
        <!-- "Event Item Count:" with the total under it -->
        <Label name="$parentTotalCaption" font="UO_DefaultText" maxchars="64" textalign="right" handleinput="false">
          <Size>
            <AbsPoint x="200" y="18" />
          </Size>
          <Anchors>
            <Anchor point="topright" relativePoint="topright">
              <AbsPoint x="-22" y="38" />
            </Anchor>
          </Anchors>
          <Color r="220" g="220" b="220" a="255" />
        </Label>
        <Label name="$parentTotal" font="UO_Title" maxchars="16" textalign="right" handleinput="false">
          <Size>
            <AbsPoint x="200" y="26" />
          </Size>
          <Anchors>
            <Anchor point="topright" relativePoint="topright">
              <AbsPoint x="-22" y="56" />
            </Anchor>
          </Anchors>
          <Color r="255" g="200" b="50" a="255" />
        </Label>
        <Label name="$parentLastDrop" font="UO_DefaultText" maxchars="64" textalign="right" handleinput="false">
          <Size>
            <AbsPoint x="200" y="18" />
          </Size>
          <Anchors>
            <Anchor point="topright" relativePoint="topright">
              <AbsPoint x="-22" y="82" />
            </Anchor>
          </Anchors>
          <Color r="160" g="160" b="160" a="255" />
        </Label>

        <HorizontalResizeImage name="$parentTopRule" inherits="UO_Default_Horizontal_Rule" handleinput="false">
          <Size>
            <AbsPoint x="384" y="4" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="106" />
            </Anchor>
          </Anchors>
        </HorizontalResizeImage>

        <!-- Event reward points, read from the event vendor's gump -->
        <Label name="$parentRewardPoints" font="UO_DefaultText" maxchars="128" textalign="left" handleinput="false">
          <Size>
            <AbsPoint x="384" y="20" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="114" />
            </Anchor>
          </Anchors>
          <Color r="255" g="200" b="50" a="255" />
        </Label>

        <Label name="$parentListHeader" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false">
          <Size>
            <AbsPoint x="380" y="20" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="136" />
            </Anchor>
          </Anchors>
          <Color r="200" g="200" b="200" a="255" />
        </Label>

        <Window name="$parentRow1" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="160" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow2" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="184" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow3" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="208" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow4" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="232" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow5" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="256" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow6" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="280" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow7" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="304" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow8" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="328" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow9" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="352" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRow10" inherits="CorksDropAlertsRowTemplate">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft">
              <AbsPoint x="18" y="376" />
            </Anchor>
          </Anchors>
        </Window>

        <!-- Bottom section, anchored to the bottom so it follows the window's height -->
        <HorizontalResizeImage name="$parentBottomRule" inherits="UO_Default_Horizontal_Rule" handleinput="false">
          <Size>
            <AbsPoint x="384" y="4" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="topleft">
              <AbsPoint x="18" y="-188" />
            </Anchor>
          </Anchors>
        </HorizontalResizeImage>

        <Button name="$parentResetButton" inherits="UO_Default_Medium_Select_Button">
          <Anchors>
            <Anchor point="bottomleft" relativePoint="bottomleft">
              <AbsPoint x="18" y="-146" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnReset" />
          </EventHandlers>
        </Button>
        <Button name="$parentRemoveButton" inherits="UO_Default_Medium_Select_Button">
          <Anchors>
            <Anchor point="bottomright" relativePoint="bottomright">
              <AbsPoint x="-18" y="-146" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnRemoveUnchecked" />
          </EventHandlers>
        </Button>
        <!-- Classic versions of the two buttons (CorksDropAlerts.ClassicButtons) -->
        <Window name="$parentResetClassic" inherits="CorksDropAlertsClassicButton">
          <Anchors>
            <Anchor point="bottomleft" relativePoint="bottomleft">
              <AbsPoint x="18" y="-150" />
            </Anchor>
          </Anchors>
        </Window>
        <Window name="$parentRemoveClassic" inherits="CorksDropAlertsClassicButton">
          <Anchors>
            <Anchor point="bottomright" relativePoint="bottomright">
              <AbsPoint x="-18" y="-150" />
            </Anchor>
          </Anchors>
        </Window>

        <!-- Event Item Tag: backpack items to count by name -->
        <Label name="$parentItemLabel" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false">
          <Size>
            <AbsPoint x="380" y="20" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="topleft">
              <AbsPoint x="18" y="-138" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <EditBox name="$parentItemTextBox" font="UO_DefaultText" taborder="2" maxchars="200" scrolling="horz" layer="overlay">
          <Size>
            <AbsPoint x="370" y="20" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="bottomleft">
              <AbsPoint x="23" y="-87" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnItemTextClick" />
            <EventHandler event="OnKeyEnter" function="CorksDropAlerts.OnItemTextEnter" />
            <EventHandler event="OnKeyEscape" function="CorksDropAlerts.OnItemTextEscape" />
          </EventHandlers>
        </EditBox>
        <!-- Size must match CorksDropAlerts.TEXTBOX_WIDTH / TEXTBOX_HEIGHT -->
        <Window name="$parentItemTextBoxBG" handleinput="false">
          <Size>
            <AbsPoint x="380" y="30" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentItemTextBox">
              <AbsPoint x="-5" y="-5" />
            </Anchor>
          </Anchors>
          <Windows>
            <FullResizeImage name="$parentBG" inherits="UO_Simple_Black_Background">
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft" />
                <Anchor point="bottomright" relativePoint="bottomright" />
              </Anchors>
            </FullResizeImage>
            <FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame">
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft" />
                <Anchor point="bottomright" relativePoint="bottomright" />
              </Anchors>
            </FullResizeImage>
          </Windows>
        </Window>

        <!-- Add a drop message -->
        <Label name="$parentTextLabel" font="UO_DefaultText" maxchars="64" textalign="left" handleinput="false">
          <Size>
            <AbsPoint x="380" y="20" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="topleft">
              <AbsPoint x="18" y="-76" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" a="255" />
        </Label>
        <EditBox name="$parentTextBox" font="UO_DefaultText" taborder="1" maxchars="200" scrolling="horz" layer="overlay">
          <Size>
            <AbsPoint x="370" y="20" />
          </Size>
          <Anchors>
            <Anchor point="bottomleft" relativePoint="bottomleft">
              <AbsPoint x="23" y="-25" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="CorksDropAlerts.OnTextClick" />
            <EventHandler event="OnKeyEnter" function="CorksDropAlerts.OnTextEnter" />
            <EventHandler event="OnKeyEscape" function="CorksDropAlerts.OnTextEscape" />
          </EventHandlers>
        </EditBox>
        <!-- Size must match CorksDropAlerts.TEXTBOX_WIDTH / TEXTBOX_HEIGHT -->
        <Window name="$parentTextBoxBG" handleinput="false">
          <Size>
            <AbsPoint x="380" y="30" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentTextBox">
              <AbsPoint x="-5" y="-5" />
            </Anchor>
          </Anchors>
          <Windows>
            <FullResizeImage name="$parentBG" inherits="UO_Simple_Black_Background">
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft" />
                <Anchor point="bottomright" relativePoint="bottomright" />
              </Anchors>
            </FullResizeImage>
            <FullResizeImage name="$parentFrame" inherits="UO_Default_Inner_Window_Frame">
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft" />
                <Anchor point="bottomright" relativePoint="bottomright" />
              </Anchors>
            </FullResizeImage>
          </Windows>
        </Window>
      </Windows>
    </Window>

  </Windows>
</Interface>
