# Files left out of GitHub's "Download ZIP" and release source archives, which
# only need what the client loads. A git clone still gets everything.

# Development tools and tests
tests               export-ignore
.luacheckrc         export-ignore
.markdownlint.json  export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore

# README and its screenshots; GitHub shows them from the repo
README.md           export-ignore
*.png               export-ignore

# Dev-only tool that makes the alert graphics (the .dds files it writes are shipped)
Tools/AlertTextures  export-ignore
